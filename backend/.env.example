NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=motocare
DATABASE_USER=motocare
DATABASE_PASSWORD=change-me-local-only

# Use a unique secret of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=1d
# Use separate random values before any public/production deployment.
# ORDER_START_HMAC_SECRET=
# PASSWORD_RESET_HMAC_SECRET=

# Default REST limit per client. Auth and uploads have stricter endpoint limits.
API_RATE_LIMIT=120
API_RATE_LIMIT_TTL_MS=60000

# Enables simulated payments only outside production. No bank transfer occurs.
DEMO_MODE=false
# For demo seed only: set three distinct 16+ character passwords in the shell.
# SEED_CUSTOMER_PASSWORD=
# SEED_PROVIDER_PASSWORD=
# SEED_ADMIN_PASSWORD=

MATCH_RADIUS_KM=10
OFFER_TTL_SECONDS=15
PROVIDER_LOCATION_MAX_AGE_SECONDS=120

# Optional educational-demo weather pricing. Fails open at multiplier 1.00.
# Open-Meteo free access is non-commercial and requires attribution.
WEATHER_PRICING_ENABLED=false
WEATHER_REQUEST_TIMEOUT_MS=1500
WEATHER_CACHE_TTL_SECONDS=300

# Chat images stay on the backend host and are never served as public static files.
CHAT_UPLOAD_DIR=storage/chat
CHAT_IMAGE_MAX_BYTES=5242880

# Password recovery email. Keep disabled until SMTP credentials are configured.
EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=MotoCare <your-email@example.com>

# SePay Test mode adapter. Keep disabled until a Test mode account and HMAC webhook exist.
# This first adapter intentionally rejects Live mode and never contains credentials in source control.
SEPAY_ENABLED=false
SEPAY_MODE=test
# SEPAY_BANK=MBBank
# Only an official fake Test mode VA is accepted: SBSEPAY + 12 uppercase letters/digits.
# Never put a real bank account number here.
# SEPAY_ACCOUNT_NUMBER=SBSEPAYX9KA2B7MN4QR
# SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_CODE_PREFIX=MC
# Optional bank/VA-required text placed before the payment code (for example SEVQR or TKP001).
SEPAY_TRANSFER_MEMO_PREFIX=
# SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_MAX_AGE_SECONDS=300
